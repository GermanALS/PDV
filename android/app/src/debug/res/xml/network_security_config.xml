<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo build de debug (src/debug/). Permite HTTP en claro hacia cualquier
  host para poder apuntar el modo REMOTO a la IP LAN de la PC de desarrollo
  (DHCP variable, no se puede listar como rango en <domain>) sobre Wi-Fi, sin
  el tunel `adb reverse` por USB. El build de release no incluye este
  archivo y declara usesCleartextTraffic="false" en el manifest principal
  (PLAN.md Parte 40); aqui el network security config tiene precedencia.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
