<?xml version="1.0" encoding="utf-8"?>
<!-- Sin respaldo en la nube ni transferencia entre dispositivos (PLAN.md
     Parte 37, A-5): las claves de Android Keystore no viajan, asi que la
     sesion y el token de IA cifrados quedarian ilegibles, y la base lleva
     hashes de usuarios e historial de ventas. Desde Android 12,
     allowBackup="false" no corta la transferencia entre dispositivos; estas
     reglas si. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
